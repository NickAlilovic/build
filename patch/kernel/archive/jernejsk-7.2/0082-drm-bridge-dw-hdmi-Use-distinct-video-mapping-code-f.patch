From 579cd8b4a1b7adde2b4c275f2aa68075df526f2d Mon Sep 17 00:00:00 2001
From: Jernej Skrabec <jernej.skrabec@gmail.com>
Date: Mon, 20 Jul 2026 12:56:38 +0200
Subject: [PATCH] drm/bridge: dw-hdmi: Use distinct video mapping code for YUV
 4:4:4

hdmi_video_sample() maps packed YUV 4:4:4 (MEDIA_BUS_FMT_YUVn_1X..)
and subsampled YUV 4:2:0 (MEDIA_BUS_FMT_UYYVYYn_0_5X..) to the same
HDMI_TX_INVID0 video mapping code at each color depth. The video
sampler needs to know which of the two packing conventions is on the
bus to correctly demux pixels; the two are not interchangeable even
though the DE gets to pick the same nominal color depth for both.
Without a distinct code, the sampler is told to treat 4:2:0's packed
Y/Y/Cb/Cr pairs as if they were regular full-rate 4:4:4 samples,
which does not produce a working picture.

meson_dw_hdmi.c also sets ycbcr_420_allowed and negotiates plain YUV
4:4:4 through this same shared function today, so unconditionally
changing the 4:4:4 codes is not safe without knowing whether that
platform's controller instance needs the same distinction or already
relies on the shared code. Gate the new codes behind a plat_data
flag instead of changing the default for every platform sharing this
function, and set it for sun8i, where the split is confirmed needed.

Signed-off-by: Jernej Skrabec <jernej.skrabec@gmail.com>
---
 drivers/gpu/drm/bridge/synopsys/dw-hdmi.c | 17 +++++++++++++----
 drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c     |  6 ++++++
 include/drm/bridge/dw_hdmi.h              | 10 ++++++++++
 3 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
index a9fd43a8781620..fad23ef65fa5e6 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-hdmi.c
@@ -1031,19 +1031,15 @@ static void hdmi_video_sample(struct dw_hdmi *hdmi)
 		color_format = 0x07;
 		break;
 
-	case MEDIA_BUS_FMT_YUV8_1X24:
 	case MEDIA_BUS_FMT_UYYVYY8_0_5X24:
 		color_format = 0x09;
 		break;
-	case MEDIA_BUS_FMT_YUV10_1X30:
 	case MEDIA_BUS_FMT_UYYVYY10_0_5X30:
 		color_format = 0x0B;
 		break;
-	case MEDIA_BUS_FMT_YUV12_1X36:
 	case MEDIA_BUS_FMT_UYYVYY12_0_5X36:
 		color_format = 0x0D;
 		break;
-	case MEDIA_BUS_FMT_YUV16_1X48:
 	case MEDIA_BUS_FMT_UYYVYY16_0_5X48:
 		color_format = 0x0F;
 		break;
@@ -1058,6 +1054,19 @@ static void hdmi_video_sample(struct dw_hdmi *hdmi)
 		color_format = 0x12;
 		break;
 
+	case MEDIA_BUS_FMT_YUV8_1X24:
+		color_format = hdmi->plat_data->ycbcr444_alt_vmap ? 0x17 : 0x09;
+		break;
+	case MEDIA_BUS_FMT_YUV10_1X30:
+		color_format = hdmi->plat_data->ycbcr444_alt_vmap ? 0x19 : 0x0B;
+		break;
+	case MEDIA_BUS_FMT_YUV12_1X36:
+		color_format = hdmi->plat_data->ycbcr444_alt_vmap ? 0x1B : 0x0D;
+		break;
+	case MEDIA_BUS_FMT_YUV16_1X48:
+		color_format = hdmi->plat_data->ycbcr444_alt_vmap ? 0x1D : 0x0F;
+		break;
+
 	default:
 		return;
 	}
diff --git a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
index aacff6448a164e..e7e40d8e6d2c5a 100644
--- a/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
+++ b/drivers/gpu/drm/sun4i/sun8i_dw_hdmi.c
@@ -302,6 +302,12 @@ static int sun8i_dw_hdmi_bind(struct device *dev, struct device *master,
 	plat_data->mode_valid = hdmi->quirks->mode_valid;
 	plat_data->use_drm_infoframe = hdmi->quirks->use_drm_infoframe;
 	plat_data->ycbcr_420_allowed = hdmi->quirks->ycbcr_420_allowed;
+	/*
+	 * The controller shares the same distinct video mapping code for
+	 * packed YUV 4:4:4 across all sun8i variants, even where YUV
+	 * output is never negotiated in practice.
+	 */
+	plat_data->ycbcr444_alt_vmap = true;
 	sun8i_hdmi_phy_set_ops(hdmi->phy, plat_data);
 
 	platform_set_drvdata(pdev, hdmi);
diff --git a/include/drm/bridge/dw_hdmi.h b/include/drm/bridge/dw_hdmi.h
index 8500dd4f99d8c1..d029a32c03a531 100644
--- a/include/drm/bridge/dw_hdmi.h
+++ b/include/drm/bridge/dw_hdmi.h
@@ -138,6 +138,16 @@ struct dw_hdmi_plat_data {
 	bool use_drm_infoframe;
 	bool ycbcr_420_allowed;
 
+	/*
+	 * Some controller instances use a distinct HDMI_TX_INVID0 video
+	 * mapping code for packed YUV 4:4:4 input, instead of sharing the
+	 * code used for subsampled YUV 4:2:0 at the same color depth.
+	 * Leave this unset unless verified against the specific instance,
+	 * since sharing the code is the long-standing default behavior
+	 * other platforms may depend on.
+	 */
+	bool ycbcr444_alt_vmap;
+
 	/*
 	 * Private data passed to all the .mode_valid() and .configure_phy()
 	 * callback functions.
